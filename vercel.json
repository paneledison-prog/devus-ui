{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "storybook.devus.space" }],
      "dest": "/storybook/$1"
    },
    { "handle": "filesystem" }
  ]
}
